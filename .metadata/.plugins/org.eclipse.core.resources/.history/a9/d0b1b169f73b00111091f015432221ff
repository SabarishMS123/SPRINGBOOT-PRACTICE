<h1 class="mb-4"><i class="fas fa-calendar-check"></i> Attendance Tracker</h1>
<form th:action="@{/attendance}" method="get" class="mb-3">
    <div class="input-group w-25">
        <input type="date" class="form-control" name="filterDate" th:value="${filterDate}">
        <button class="btn btn-outline-primary">Filter by Date</button>
        <a th:href="@{/attendance}" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

<form th:action="@{/attendance/submit}" method="post" th:object="${attendance}" class="row g-3 mb-5 card p-4">
    <div class="col-md-5"><input type="text" class="form-control" placeholder="Student Name" th:field="*{studentName}" required></div>
    <div class="col-md-3"><input type="date" class="form-control" th:field="*{date}" required></div>
    <div class="col-md-2">
        <select class="form-select" th:field="*{status}">
            <option value="Present">Present</option>
            <option value="Absent">Absent</option>
        </select>
    </div>
    <div class="col-md-2"><button type="submit" class="btn btn-primary w-100">Mark Attendance</button></div>
</form>

<table class="table table-hover">
    <thead><tr><th>Student</th><th>Date</th><th>Status</th></tr></thead>
    <tbody>
        <tr th:each="att : ${attendanceList}">
            <td th:text="${att.studentName}"></td>
            <td th:text="${#dates.format(att.date, 'dd MMM yyyy')}"></td>
            <td><span th:if="${att.status == 'Present'}" class="badge bg-success">Present</span>
                <span th:else class="badge bg-danger">Absent</span></td>
        </tr>
    </tbody>
</table>