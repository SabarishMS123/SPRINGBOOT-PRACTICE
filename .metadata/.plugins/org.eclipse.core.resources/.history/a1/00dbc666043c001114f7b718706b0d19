<h1 class="mb-4"><i class="fas fa-address-book"></i> Contact Book</h1>
<form th:action="@{/contacts}" method="get" class="mb-4">
    <div class="input-group w-50">
        <input type="text" class="form-control" placeholder="Search by name..." name="search" th:value="${search}">
        <button class="btn btn-outline-primary">Search</button>
        <a th:href="@{/contacts}" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

<form th:action="@{/contacts/add}" method="post" th:object="${contact}" class="row g-3 mb-5 card p-4">
    <div class="col-md-4"><input type="text" class="form-control" placeholder="Name" th:field="*{name}" required></div>
    <div class="col-md-3"><input type="tel" class="form-control" placeholder="Phone" th:field="*{phoneNumber}" required></div>
    <div class="col-md-3"><input type="email" class="form-control" placeholder="Email" th:field="*{email}"></div>
    <div class="col-md-2"><button type="submit" class="btn btn-primary w-100">Add Contact</button></div>
</form>

<table class="table table-hover">
    <thead><tr><th>Name</th><th>Phone</th><th>Email</th></tr></thead>
    <tbody>
        <tr th:each="c : ${contactList}">
            <td th:text="${c.name}"></td>
            <td th:text="${c.phoneNumber}"></td>
            <td th:text="${c.email}"></td>
        </tr>
    </tbody>
</table>