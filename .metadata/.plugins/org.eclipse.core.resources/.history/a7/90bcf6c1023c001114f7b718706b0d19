<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <title>SmartOps - Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <style>
        .module-card {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .module-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 35px rgba(13, 110, 253, 0.18) !important;
        }
        .icon-big { font-size: 3.2rem; }
    </style>
</head>
<body class="bg-light">

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
        <div class="container">
            <a class="navbar-brand" th:href="@{/}">
                <i class="fas fa-cogs me-2"></i>SmartOps
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link active" th:href="@{/}">Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" th:href="@{/feedback}">Feedback</a></li>
                    <li class="nav-item"><a class="nav-link" th:href="@{/attendance}">Attendance</a></li>
                    <li class="nav-item"><a class="nav-link" th:href="@{/todo}">To-Do</a></li>
                    <li class="nav-item"><a class="nav-link" th:href="@{/orders}">Orders</a></li>
                    <li class="nav-item"><a class="nav-link" th:href="@{/contacts}">Contacts</a></li>
                    <li class="nav-item"><a class="nav-link" th:href="@{/leaves}">Leaves</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="text-center mb-5">
                    <h1 class="display-5 fw-bold text-primary">Welcome to SmartOps</h1>
                    <p class="lead text-muted">Integrated Spring Boot + JPA + Thymeleaf System</p>
                </div>

                <div class="row g-4">
                    <div class="col-md-6 col-lg-4" th:each="module : ${#lists.list(
                        #{'name':'Feedback','icon':'fa-comment-dots','url':'/feedback'},
                        #{'name':'Attendance','icon':'fa-calendar-check','url':'/attendance'},
                        #{'name':'To-Do','icon':'fa-tasks','url':'/todo'},
                        #{'name':'Orders','icon':'fa-utensils','url':'/orders'},
                        #{'name':'Contacts','icon':'fa-address-book','url':'/contacts'},
                        #{'name':'Leaves','icon':'fa-plane-departure','url':'/leaves'}
                    )}">
                        <div class="card module-card border-0 shadow-sm h-100 text-center p-4">
                            <i th:class="'fas ' + ${module.icon} + ' icon-big text-primary mb-3'"></i>
                            <h5 th:text="${module.name}"></h5>
                            <a th:href="@{${module.url}}" class="btn btn-outline-primary mt-3">Open Module →</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>