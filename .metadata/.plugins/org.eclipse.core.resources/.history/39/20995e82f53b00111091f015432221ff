<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <title>SmartOps - Integrated Management System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary: #0d6efd;
        }
        .navbar-brand {
            font-weight: 700;
            letter-spacing: -1px;
        }
        .module-card {
            transition: all 0.3s ease;
            height: 100%;
        }
        .module-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 30px rgba(13, 110, 253, 0.2) !important;
        }
        .icon-big {
            font-size: 3.5rem;
            margin-bottom: 1rem;
        }
    </style>
</head>
<body class="bg-light">

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow">
        <div class="container">
            <a class="navbar-brand" href="/">
                <i class="fas fa-cogs me-2"></i>SmartOps
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link active" href="/">🏠 Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" href="/feedback">📝 Feedback</a></li>
                    <li class="nav-item"><a class="nav-link" href="/attendance">📅 Attendance</a></li>
                    <li class="nav-item"><a class="nav-link" href="/todo">✅ To-Do</a></li>
                    <li class="nav-item"><a class="nav-link" href="/orders">🍽️ Orders</a></li>
                    <li class="nav-item"><a class="nav-link" href="/contacts">📇 Contacts</a></li>
                    <li class="nav-item"><a class="nav-link" href="/leaves">🗓️ Leaves</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container py-5">
        <div class="text-center mb-5">
            <h1 class="display-4 fw-bold text-primary">Welcome to SmartOps</h1>
            <p class="lead text-muted">A complete Spring Boot + Thymeleaf + JPA mini project with all 6 tasks integrated.</p>
        </div>

        <div class="row g-4">
            <!-- Module Cards -->
            <div class="col-md-4">
                <div class="card module-card border-0 shadow-sm text-center p-4">
                    <i class="fas fa-comment-dots icon-big text-primary"></i>
                    <h5>Feedback System</h5>
                    <p class="text-muted small">Submit feedback with star rating</p>
                    <a href="/feedback" class="btn btn-outline-primary mt-3">Go to Feedback →</a>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card module-card border-0 shadow-sm text-center p-4">
                    <i class="fas fa-calendar-check icon-big text-primary"></i>
                    <h5>Attendance Tracker</h5>
                    <p class="text-muted small">Mark & filter student attendance</p>
                    <a href="/attendance" class="btn btn-outline-primary mt-3">Go to Attendance →</a>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card module-card border-0 shadow-sm text-center p-4">
                    <i class="fas fa-tasks icon-big text-primary"></i>
                    <h5>To-Do List</h5>
                    <p class="text-muted small">Manage tasks with completed section</p>
                    <a href="/todo" class="btn btn-outline-primary mt-3">Go to To-Do →</a>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card module-card border-0 shadow-sm text-center p-4">
                    <i class="fas fa-utensils icon-big text-primary"></i>
                    <h5>Restaurant Orders</h5>
                    <p class="text-muted small">Place orders & see total items</p>
                    <a href="/orders" class="btn btn-outline-primary mt-3">Go to Orders →</a>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card module-card border-0 shadow-sm text-center p-4">
                    <i class="fas fa-address-book icon-big text-primary"></i>
                    <h5>Contact Book</h5>
                    <p class="text-muted small">Add & search contacts</p>
                    <a href="/contacts" class="btn btn-outline-primary mt-3">Go to Contacts →</a>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card module-card border-0 shadow-sm text-center p-4">
                    <i class="fas fa-plane-departure icon-big text-primary"></i>
                    <h5>Leave Management</h5>
                    <p class="text-muted small">Submit leave with auto day calculation</p>
                    <a href="/leaves" class="btn btn-outline-primary mt-3">Go to Leaves →</a>
                </div>
            </div>
        </div>

        <div class="text-center mt-5">
            <div class="alert alert-info d-inline-block">
                <strong>Senior Dev Note:</strong> Service Layer + JPA + Thymeleaf + Bootstrap<br>
                All extra challenges implemented • Auto database schema
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>